import { Button, VerticalBox, HorizontalBox, GroupBox, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Live Audio Control Plane";
    width: 500px;
    height: 560px;
    background: #1e1e24;

    in property <string> orbits-status: "Offline";
    in property <string> vocals-status: "Offline";
    in property <color> orbits-color: #ff5555;
    in property <color> vocals-color: #ff5555;
    in property <string> log-output: "";

    callback boot-orbits();
    callback boot-vocals();
    callback panic-orbits();
    callback panic-vocals();
    callback force-restart-all();

    VerticalBox {
        padding: 20px;
        spacing: 15px;

        Text {
            text: "SYSTEM CONTROLLER";
            font-size: 20px;
            font-weight: 700;
            color: #ffffff;
            horizontal-alignment: center;
        }

        HorizontalBox {
            spacing: 20px;

            GroupBox {
                title: "Orbits";
                VerticalBox {
                    spacing: 10px;
                    HorizontalBox {
                        Text { text: "Status: "; color: #aaaaaa; }
                        Text { text: root.orbits-status; color: root.orbits-color; font-weight: 700; }
                    }
                    Button {
                        text: "BOOT SERVER";
                        clicked => { root.boot-orbits(); }
                    }
                    Button {
                        text: "PANIC ORBITS";
                        clicked => { root.panic-orbits(); }
                    }
                }
            }

            GroupBox {
                title: "Vocals";
                VerticalBox {
                    spacing: 10px;
                    HorizontalBox {
                        Text { text: "Status: "; color: #aaaaaa; }
                        Text { text: root.vocals-status; color: root.vocals-color; font-weight: 700; }
                    }
                    Button {
                        text: "BOOT SERVER";
                        clicked => { root.boot-vocals(); }
                    }
                    Button {
                        text: "PANIC VOCALS";
                        clicked => { root.panic-vocals(); }
                    }
                }
            }
        }

        VerticalBox {
            alignment: end;
            Button {
                text: "Force Restart All Servers";
                clicked => { root.force-restart-all(); }
            }
        }

        GroupBox {
            title: "Terminal Output";
            log-scroll := ScrollView {
                height: 90px;
                vertical-scrollbar-policy: always-on;
                horizontal-scrollbar-policy: always-off;

                log-text := Text {
                    width: parent.width;
                    text: root.log-output;
                    color: #33ff66;
                    font-family: "monospace";
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }
    }

    changed log-output => {
        log-scroll.viewport-y = -max(0px, log-text.height - log-scroll.height);
    }
}
