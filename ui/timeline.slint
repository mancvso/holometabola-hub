// ─────────────────────────────────────────────────────────────
// SONG view: DAW-style timeline of a song, in musical beats.
// Sections are placed by start_beat / duration_beats (integers,
// PLAN §4/R5); the pixel axis is pixels-per-beat (R14). Grid and
// ruler speak cycles (C6): one line and tick per cycle, a number
// every four cycles. Fed by Rust from runs/<song>/sections.json
// (WP-C document); the stepper interaction lives in the selector
// bar of app.slint (R17), not per block.
// ─────────────────────────────────────────────────────────────
import { ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct SectionData {
    name: string,
    start-beat: int,
    duration-beats: int,
    is-active: bool,
    // Identity in the Rust document (index into SongDoc.sections).
    // Carried so a tap can be resolved without positional guessing;
    // the model itself is read-only from Slint (guard 1).
    section-id: int,
}

export struct TrackData {
    name: string,
    is-soloed: bool,
    is-muted: bool,
    sections: [SectionData],
}

export struct GroupData {
    name: string,
    accent: color,
    tracks: [TrackData],
}

component TrackHeader inherits Rectangle {
    in property <string> track-name: "Track";
    in property <color> accent: Theme.accent-orbits;
    in property <bool> is-soloed: false;
    in property <bool> is-muted: false;

    width: 160px;
    height: 36px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border-soft;

    HorizontalBox {
        padding-left: Theme.pad-m;
        padding-right: Theme.pad-m;
        spacing: Theme.pad-xs;

        Text {
            text: root.track-name;
            color: root.is-muted ? Theme.text-dim : Theme.text;
            vertical-alignment: center;
            font-size: Theme.fs-m * 1px;
            font-weight: 700;
            font-family: Theme.font;
            horizontal-stretch: 1;
        }

        // Solo indicator
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 3px;
            background: root.is-soloed ? Theme.warn : Theme.node-bg;
            Text {
                text: "S";
                color: root.is-soloed ? Theme.bg : Theme.text-dim;
                font-size: Theme.fs-s * 1px;
                font-weight: 700;
                font-family: Theme.font;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Mute indicator
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 3px;
            background: root.is-muted ? Theme.danger : Theme.node-bg;
            Text {
                text: "M";
                color: root.is-muted ? Theme.text : Theme.text-dim;
                font-size: Theme.fs-s * 1px;
                font-weight: 700;
                font-family: Theme.font;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component SectionBlock inherits Rectangle {
    in property <string> name: "Section";
    in property <bool> is-active: true;
    in property <bool> is-selected: false;
    in property <color> base-color: Theme.accent-orbits;

    border-radius: Theme.corner;
    // A selected block gets a heavier frame (Theme.warn) -- the only
    // visual state the stepper interaction adds; all numbers behind
    // it are decided in Rust (guard 1).
    border-width: root.is-selected ? 3px : 1px;
    background: root.base-color;
    border-color: root.is-selected
        ? Theme.warn
        : (root.is-active ? root.base-color.brighter(30%) : root.base-color.darker(40%));
    opacity: root.is-active ? 0.9 : 0.3;

    Text {
        text: root.name;
        color: root.is-active ? Theme.bg : Theme.text-dim;
        font-size: Theme.fs-s * 1px;
        font-family: Theme.font;
        x: Theme.pad-s;
        vertical-alignment: center;
    }
}

export component SongTimeline inherits Rectangle {
    preferred-width: 900px;
    preferred-height: 760px;
    background: Theme.bg;

    // ── musical-time axis (R14/C9) ───────────────────────────
    // Pixels per beat. No zoom control (R14): change this constant
    // and rebuild. Bound nowhere else on purpose -- the default is
    // the design value.
    in property <float> pixels-per-beat: 8.0;
    // Total song length in beats (drives ruler + viewport width).
    in property <int> song-length-beats: 16;
    // Beats per cycle, from the document (R18/R19: never hardcoded
    // at a call site; the grid and coarse steps both read this).
    in property <int> beats-per-cycle: 4;
    // Playhead in beats; negative hides it (C9: bound only when the
    // WP-D beat clock is wired -- default -1 keeps it invisible).
    in property <float> song-playhead-beats: -1.0;

    // ── interaction surface (E2) ──────────────────────────
    // Slint reports taps and highlights the selection; nothing else
    // happens here. Clamping, neighbour checks and the dirty flag
    // are Rust's job (R10/R11, guard 1).
    in property <bool> song-dirty: false;
    in property <int> sel-group: -1;
    in property <int> sel-track: -1;
    in property <int> sel-index: -1;
    callback section-tapped(int, int, int);

    // Number of cycle columns to draw: capped by the song length
    // (guard 15), plus one so a section ending mid-view still has a
    // closing line.
    property <int> cycle-count:
        (root.song-length-beats / max(root.beats-per-cycle, 1) + 1);

    // Injected by Rust on APPLY. Kept populated with a small beat-
    // based mock so the timeline is always instantiated with data;
    // Rust overwrites it.
    in property <[GroupData]> groups: [
        {
            name: "BEATS",
            accent: Theme.accent-tidal,
            tracks: [
                {
                    name: "b1",
                    is-muted: false,
                    is-soloed: false,
                    sections: [
                        { name: "intro", start-beat: 0, duration-beats: 16, is-active: true, section-id: 0 },
                        { name: "groove", start-beat: 16, duration-beats: 8, is-active: true, section-id: 1 },
                    ]
                },
            ]
        },
        {
            name: "LEADS",
            accent: Theme.accent-orbits,
            tracks: [
                {
                    name: "l1",
                    is-muted: false,
                    is-soloed: false,
                    sections: [
                        { name: "section-2", start-beat: 8, duration-beats: 4, is-active: true, section-id: 2 },
                    ]
                },
            ]
        },
        {
            name: "AMBIENTS",
            accent: Theme.accent-rec,
            tracks: [
                {
                    name: "a1",
                    is-muted: false,
                    is-soloed: false,
                    sections: [
                        { name: "pad", start-beat: 4, duration-beats: 12, is-active: true, section-id: 3 },
                    ]
                },
            ]
        },
    ];

    // Group accents, indexed in the same order as `groups` (BEATS,
    // LEADS, AMBIENTS). Kept here rather than on each GroupData so the
    // Rust parser never needs to know a color -- same convention as
    // the mute grid (mute_model() in main.rs).
    property <[color]> group-accents: [
        Theme.group-beats, Theme.group-leads, Theme.group-ambients,
    ];

    // Accent for group i, falling back to the first when out of range.
    function accent-for(i: int) -> color {
        root.group-accents[i < 0 || i >= root.group-accents.length ? 0 : i]
    }

    property <length> header-w: 160px;

    // Top bar: title + read-only note
    VerticalBox {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 36px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalBox {
                padding-left: Theme.pad-xl;
                spacing: Theme.spacing-l;
                Text {
                    text: "SONG TIMELINE";
                    color: Theme.text;
                    font-size: Theme.fs-s * 1px;
                    font-weight: 700;
                    font-family: Theme.font;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                }
                Text {
                    // Editable in beats: tap a block, step it in the
                    // selector bar, SAVE writes it back (R17).
                    text: root.song-dirty ? "editable · unsaved edits ●" : "editable · tap a block to select";
                    color: root.song-dirty ? Theme.warn : Theme.text-dim;
                    font-size: Theme.fs-xs * 1px;
                    font-family: Theme.font;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            viewport-width: root.header-w
                + root.song-length-beats * root.pixels-per-beat * 1px
                + 40px;

            VerticalBox {
                alignment: start;
                spacing: Theme.spacing-l;
                padding: Theme.pad-m;

                // Time ruler: one tick per cycle, a cycle number every
                // four cycles (C6). Exact beat numbers live in the
                // stepper-row readout, not here.
                Rectangle {
                    height: 20px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border-soft;

                    HorizontalBox {
                        Rectangle { width: root.header-w; }
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;
                            for i in root.cycle-count : Rectangle {
                                x: (i * root.beats-per-cycle) * root.pixels-per-beat * 1px;
                                width: 60px;
                                height: 100%;
                                Rectangle {
                                    width: 1px;
                                    height: 100%;
                                    background: Theme.border;
                                }
                                Text {
                                    visible: Math.mod(i, 4) == 0;
                                    x: 4px;
                                    text: "c\{i}";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-xs * 1px;
                                    font-family: Theme.font;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                for group[group-index] in root.groups : VerticalBox {
                    padding: 0px;
                    spacing: 2px;

                    // Group header
                    Rectangle {
                        height: 20px;
                        background: Theme.node-bg;
                        border-radius: Theme.corner;
                        Text {
                            text: group.name;
                            color: root.accent-for(group-index);
                            font-size: Theme.fs-s * 1px;
                            font-weight: 700;
                            font-family: Theme.font;
                            letter-spacing: 3px;
                            x: Theme.pad-m;
                            vertical-alignment: center;
                        }
                    }

                    for track[track-index] in group.tracks : HorizontalBox {
                        height: (track-index > 2 && track-index < 4) ? 48px : 24px;
                        spacing: 0px;

                        TrackHeader {
                            track-name: track.name;
                            accent: root.accent-for(group-index);
                            is-soloed: track.is-soloed;
                            is-muted: track.is-muted;
                        }

                        // Lane. Slint 1.17 does NOT stretch layout
                        // children on the cross axis, and a `height:
                        // 100%` on a layout child is ignored: an
                        // unstretched lane collapses to its measured
                        // content (~20px) and clip:true then slices the
                        // blocks -- the half-height bug, present since
                        // the seconds era. Pin it to the row explicitly
                        // (a plain Rectangle's height binding IS honored
                        // inside a box, verified with a render probe).
                        Rectangle {
                            horizontal-stretch: 1;
                            height:  (track-index > 2 && track-index < 4) ? 48px : 24px;
                            background: Theme.panel;
                            border-width: 1px;
                            border-color: Theme.border-soft;
                            clip: true;

                            // Cycle grid per lane (one line per cycle,
                            // C6). Integer-strided and capped by
                            // cycle-count (guard 15).
                            for i in root.cycle-count : Rectangle {
                                x: (i * root.beats-per-cycle) * root.pixels-per-beat * 1px;
                                width: 1px;
                                height: 100%;
                                background: Theme.border-soft;
                            }

                            for section[section-index] in track.sections : Rectangle {
                                x: section.start-beat * root.pixels-per-beat * 1px;
                                // 30px is a render floor only (guard 6):
                                // the data floor is 1 beat, enforced in
                                // Rust. Legality (R10/C4) never touches
                                // widths here.
                                width: max(section.duration-beats * root.pixels-per-beat * 1px, 30px);
                                // Blocks fill the lane band: 30px of the
                                // 36px row, 2px of breathing top and
                                // bottom (36 - 2 - 30 = 4 >= the 2px y).
                                height: (track-index > 2 && track-index < 4) ? 40px : 20px;
                                y:  (track-index > 2 && track-index < 4) ? 4px : 2px;

                                SectionBlock {
                                    // Explicit fill: children of a plain
                                    // Rectangle auto-fill in theory, but
                                    // pin the size so a parent bound
                                    // change cannot half-size them.
                                    width: 100%;
                                    height: 100%;
                                    name: section.name;
                                    is-active: section.is-active;
                                    base-color: root.accent-for(group-index);
                                    // Selection is positional here; the
                                    // numbers stay in the document (R11).
                                    is-selected: group-index == root.sel-group
                                        && track-index == root.sel-track
                                        && section-index == root.sel-index;
                                }

                                // Declared AFTER the visuals it covers:
                                // item order is z-order (guard 4). One
                                // TouchArea per block, clicked only --
                                // the first click selects and does not
                                // move (R17).
                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.section-tapped(group-index, track-index, section-index);
                                    }
                                }
                            }

                            // Playhead (C9: hidden until the beat clock
                            // binds song-playhead-beats). Declared last
                            // on purpose: item order is z-order and it
                            // must not eat taps (guard 4) -- it carries
                            // no TouchArea.
                            Rectangle {
                                visible: root.song-playhead-beats >= 0.0;
                                x: root.song-playhead-beats * root.pixels-per-beat * 1px;
                                width: 2px;
                                height: 100%;
                                background: Theme.warn;
                            }
                        }
                    }
                }
            }
        }
    }
}
